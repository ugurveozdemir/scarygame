[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="interactable"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

